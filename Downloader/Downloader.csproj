<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>tools\DownloaderIcon.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<GenerateExecutable>true</GenerateExecutable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
		<PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
		<PackageReference Include="MySql.Data" Version="9.6.0" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.3" />
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
		<PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="tools\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>

		</Content>
	</ItemGroup>
</Project>