<UserControl x:Class="Downloader.VideoEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="← Back" Grid.Row="0"
                HorizontalAlignment="Left" Margin="10"
                Background="Transparent" Foreground="White" BorderThickness="0"
                Click="BackButton_Click"/>

        <Grid Grid.Row="1">
            <MediaElement x:Name="previewPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"/>
            <TextBlock x:Name="LoadingText" Text="Loading preview..."
                       Foreground="White" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14"/>
        </Grid>

        <Grid Grid.Row="2" Height="60" Background="#3C3F41"/>
    </Grid>
</UserControl>