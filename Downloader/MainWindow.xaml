<Window x:Class="Downloader.MainWindow"  Background="#FF2B2B2B"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Downloader"
        mc:Ignorable="d"
        Title="Downloader" Width="600" Height="500"
        MinWidth="600" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        Icon="/tools/DownloaderIcon.ico">

    <Grid Background="#2B2B2B" Margin="30" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
       
        <Label Grid.Row="0"
               Content="Download video from Youtube"
               Foreground="White" FontSize="18"
               HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Label Grid.Row="1"
               x:Name="urlLabel" Content="Paste link here:"
               Foreground="DarkGray" FontSize="10"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="urlTable"
                     TextChanged="urlTable_TextChanged"
                     Grid.Column="0"
                     Foreground="Gray" Background="#3C3F41"
                     BorderBrush="#555" FontSize="14"
                     Height="35" Padding="8,0"
                     VerticalContentAlignment="Center"/>

            <ComboBox x:Name="typeBox"
                      Grid.Column="1" Width="80" Height="35"
                      Margin="10,0,0,0" Background="#3C3F41"
                      Foreground="white" Padding="5,0,0,0" VerticalAlignment="Bottom"/>

            <ComboBox x:Name="qualityBox"
                      Grid.Column="2" Width="80" Height="35"
                      Margin="10,0,0,0" Background="#3C3F41"
                       Padding="5,0,0,0" Foreground="White"/>
        </Grid>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Hidden"
                      Margin="0,10,0,0">
            <ItemsControl x:Name="videoList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3C3F41" CornerRadius="8"
                                Margin="0,5,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <Button Grid.Row="0"
                                        Grid.RowSpan="2"
                                       
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="✕"
                                        Width="24" Height="24"
                                        Foreground="White"
                                        VerticalAlignment="Top" 
                                        HorizontalAlignment="Right"
                                        Margin="0,-9,0,0" 
                                        Padding="0"
                                        Panel.ZIndex="10"
                                        Tag="{Binding}"
                                        Click="RemoveCard_Click">
                                    <Button.Resources>
                                        <Thickness x:Key="ButtonPadding">0</Thickness>
                                    </Button.Resources>
                                </Button>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ThumbnailUrl}"
                   Width="120" Height="70"
                   Stretch="UniformToFill"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                           Foreground="White" FontSize="13"
                           FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Duration}"
                           Foreground="Gray" FontSize="11"
                           Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Author}"
                           Foreground="#888" FontSize="10"
                           Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                    Content="Download"
                    Width="100" Height="35"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FF0000" Foreground="White"
                    Margin ="0,15,0,0"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Click="Button_Click"/>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                     Style="{x:Null}" 
                                     Value="{Binding Progress}"
                                     Height="6" Margin="0,8,0,2"
                                     Background="#2B2B2B"
                                     Foreground="LimeGreen"
                                     Minimum="0" Maximum="100"/>

                                <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   Foreground="#AAA" FontSize="10"
                   HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
      
        </Grid>
</Window>