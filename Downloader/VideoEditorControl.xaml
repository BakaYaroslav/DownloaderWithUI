<UserControl x:Class="Downloader.VideoEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Button Content="← Back" HorizontalAlignment="Left"
                    Background="Transparent" Foreground="White"
                    BorderThickness="0" Click="BackButton_Click"/>

            <Button Content="Save" Width="80" HorizontalAlignment="Right"
                    Background="LimeGreen" Foreground="Black" BorderThickness="0"
                    Click="SaveButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <vlc:VideoView x:Name="videoView"/>
            <TextBlock x:Name="LoadingText" Text="Loading preview..."
                       Foreground="White" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14"/>
        </Grid>

        <Button x:Name="PlayPauseButton" Grid.Row="2"
        Width="44" Height="44"
        HorizontalAlignment="Center" Margin="0,8,0,8"
        Click="PlayPauseButton_Click"
        Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="circle" Fill="#555"/>
                        <Path x:Name="pauseIcon" Data="M 16,14 L 16,30 M 24,14 L 24,30"
                      Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Height="18" Stretch="Fill" Width="14"/>
                        <Path x:Name="playIcon" Data="M 16,13 L 30,20 L 16,27 Z"
                      Fill="White" Visibility="Collapsed"
                      HorizontalAlignment="Right" Margin="0,2,13,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="circle" Property="Fill" Value="#777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid Grid.Row="3" Height="90" Background="#3C3F41" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Canvas x:Name="TimelineCanvas" Grid.Row="0" Background="#222"
                    SizeChanged="TimelineCanvas_SizeChanged"
                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                    MouseMove="TimelineCanvas_MouseMove"
                    MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp">
                <Rectangle x:Name="TrimOverlayLeft" Fill="#AA000000" Height="60"/>
                <Rectangle x:Name="TrimOverlayRight" Fill="#AA000000" Height="60"/>
                <Thumb x:Name="StartHandle" Width="10" Height="60" Background="LimeGreen"
                       DragDelta="StartHandle_DragDelta" Cursor="SizeWE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Rectangle Fill="LimeGreen"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="EndHandle" Width="10" Height="60" Background="OrangeRed"
                       DragDelta="EndHandle_DragDelta" Cursor="SizeWE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Rectangle Fill="OrangeRed"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Line x:Name="Playhead" Y1="0" Y2="60" Stroke="White" StrokeThickness="2"/>
            </Canvas>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="🔊" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="100" Value="100"
                        ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="TrimLabel" Foreground="#AAA" FontSize="11"
                           Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>