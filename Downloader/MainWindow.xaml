<Window x:Class="Downloader.MainWindow"  Background="#FF2B2B2B"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Downloader"
        mc:Ignorable="d"
        Title="Downloader" Width="600" Height="500"
        MinWidth="600" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        Icon="/tools/DownloaderIcon.ico">

    <Grid Background="#2B2B2B" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Download video from Youtube"
           Foreground="White" FontSize="18"
           HorizontalAlignment="Center"/>

            <Button x:Name="ProfileBtn"
            Width="36" Height="36"
            HorizontalAlignment="Right"
            BorderThickness="0"
            Padding="0"
            Click="ProfileBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <Grid Width="36" Height="36">
                    <Ellipse Fill="#FF0000"/>
                    <TextBlock x:Name="InitialsText"
                       Text="?"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <Popup x:Name="ProfilePopup"
       PlacementTarget="{Binding ElementName=ProfileBtn}"
       Placement="Left"
       StaysOpen="False"
       HorizontalOffset="8"
       AllowsTransparency="True">
            <Border Background="#2B2B2B"
            CornerRadius="10"
            Padding="12"
            Width="200"
            BorderBrush="#444"
            BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.6" ShadowDepth="4" Color="Black"/>
                </Border.Effect>
                <StackPanel>
            
                    <StackPanel.Resources>
                        <Style x:Key="MenuBtn" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="4,5"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock x:Name="CurrentLoginText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       Margin="0,0,0,2"/>
                    <TextBlock x:Name="StatsText"
                       Foreground="#888"
                       FontSize="10"
                       Margin="0,0,0,8"/>

                    <Separator Background="#555" Margin="0,0,0,6"/>

                    <TextBlock Text="Accounts"
                       Foreground="#666"
                       FontSize="9"
                       Margin="0,0,0,4"/>

                    <ItemsControl x:Name="AccountsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="12"
                                Padding="4,5"
                                Tag="{Binding}"
                                Click="SwitchAccount_Click"
                                Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#555" Margin="0,6,0,4"/>

                    <Button Content="+ Add account"
                    Foreground="#AAA"
                    Style="{StaticResource MenuBtn}"
                    Click="AddAccount_Click"/>

                    <Button Content="Remove this account"
                    Foreground="IndianRed"
                    Style="{StaticResource MenuBtn}"
                    Click="RemoveAccount_Click"/>

                    <Button Content="Log out"
                    Foreground="#AAA"
                    Style="{StaticResource MenuBtn}"
                    Click="LogOut_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="urlLabel" Text="Paste link here:" Grid.Row="0" Grid.Column="0" 
               Foreground="DarkGray" FontSize="10" VerticalAlignment="Bottom"/>

            <TextBlock x:Name="FormatLabel" Text="Format" Grid.Row="0" Grid.Column="1" 
               Foreground="DarkGray" FontSize="10" Margin="10,-2,0,0" Width="80"/>

            <TextBlock x:Name="QualityLabel" Text="Quality" Grid.Row="0" Grid.Column="2" 
               Foreground="DarkGray" FontSize="10" Margin="10,-2,0,0" Width="80"/>

            <TextBox x:Name="urlTable" Grid.Row="1" Grid.Column="0"
             TextChanged="urlTable_TextChanged"
             Foreground="Gray" Background="#3C3F41"
             BorderBrush="#555" FontSize="14"
             Height="35" Padding="8,0"
             VerticalContentAlignment="Center"/>

            <ComboBox x:Name="typeBox" Grid.Row="1" Grid.Column="1" 
              Width="80" Height="35"
              Margin="10,0,0,0" Background="#3C3F41"
              Foreground="white" VerticalAlignment="Bottom"/>

            <ComboBox x:Name="qualityBox" Grid.Row="1" Grid.Column="2" 
              Width="80" Height="35"
              Margin="10,0,0,0" Background="#3C3F41"
              Padding="5,0,0,0" Foreground="White"/>
        </Grid>

        <ScrollViewer Grid.Row="4"
              VerticalScrollBarVisibility="Hidden"
              Margin="0,10,0,0">
            <ItemsControl x:Name="videoList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3C3F41" CornerRadius="8"
                                Margin="0,5,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <Button Grid.Row="0"
                                        Grid.RowSpan="2"
                                       
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="✕"
                                        Width="24" Height="24"
                                        Foreground="White"
                                        VerticalAlignment="Top" 
                                        HorizontalAlignment="Right"
                                        Margin="0,-9,0,0" 
                                        Padding="0"
                                        Panel.ZIndex="10"
                                        Tag="{Binding}"
                                        Click="RemoveCard_Click">
                                    <Button.Resources>
                                        <Thickness x:Key="ButtonPadding">0</Thickness>
                                    </Button.Resources>
                                </Button>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ThumbnailUrl}"
                   Width="120" Height="70"
                   Stretch="UniformToFill"/>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                           Foreground="White" FontSize="13"
                           FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Duration}"
                           Foreground="Gray" FontSize="11"
                           Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Author}"
                           Foreground="#888" FontSize="10"
                           Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding FileSizeDisplay}"
                            Foreground="#888" FontSize="10"
                            Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                    Content="Download"
                    Width="100" Height="35"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FF0000" Foreground="White"
                    Margin ="0,15,0,0"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Click="Button_Click"/>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                     Style="{x:Null}" 
                                     Value="{Binding Progress}"
                                     Height="6" Margin="0,8,0,2"
                                     Background="#2B2B2B"
                                     Foreground="LimeGreen"
                                     Minimum="0" Maximum="100"/>

                                <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   Foreground="#AAA" FontSize="10"
                   HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>