<Window x:Class="Downloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Downloader"
        mc:Ignorable="d"
        Title="Downloader" Width="600" Height="420"
        ResizeMode="NoResize">
    <Grid Background="#2B2B2B">
        <StackPanel VerticalAlignment="Top" Margin="30">

            <Label Content="Download video from Youtube"
                   Foreground="White" FontSize="18"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Label x:Name="urlLabel" Content="Paste link here:" Foreground="DarkGray" FontSize="10"/>

            <!-- Строка с url и кнопками -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="urlTable"
                         TextChanged="urlTable_TextChanged"
                         Grid.Column="0"
                         Foreground="Gray" Background="#3C3F41"
                         BorderBrush="#555" FontSize="14"
                         Height="35" Padding="8,0"
                         VerticalContentAlignment="Center"/>
                <ComboBox x:Name="typeBox"
                          Grid.Column="1" Width="80" Height="35"
                          Margin="10,0,0,0" Background="#3C3F41"/>
                <ComboBox x:Name="qualityBox"
                          Grid.Column="2" Width="80" Height="35"
                          Margin="10,0,0,0" Background="#3C3F41"/>
            </Grid>

            <!-- Карточка превью -->
            <Border  x:Name="previewCard" Visibility="Collapsed" Background="#3C3F41" CornerRadius="8"
                    Margin="0,15,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="thumbnail"
                           Width="120" Height="70" Stretch="UniformToFill"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="videoTitle"
                                   Foreground="White" FontSize="13"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="videoInfo"
                                   Foreground="Gray" FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Download"
                            Width="100" Height="35"
                            Margin="10,0,0,0"
                            Background="#FF0000" Foreground="White"
                            BorderThickness="0"
                            Click="Button_Click"/>
                </Grid>
            </Border>

            <!-- Прогресс -->
            <ProgressBar x:Name="progressBar"
                         Height="10" Margin="0,10,0,0"
                         Background="#3C3F41" Foreground="Green"
                         Minimum="0" Maximum="100" Value="0"/>
            <Label x:Name="progressLabel"
                   Foreground="White" FontSize="12" Content="0%" />

        </StackPanel>
    </Grid>
</Window>