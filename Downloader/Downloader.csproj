<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>tools\DownloaderIcon.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
		<PackageReference Include="MySql.Data" Version="9.6.0" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.3" />
		<PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="tools\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>