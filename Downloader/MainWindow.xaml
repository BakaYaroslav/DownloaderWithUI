<Window x:Class="Downloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Downloader"
        mc:Ignorable="d"
        Title="Downloader" Width="600" Height="300"
        ResizeMode="NoResize">

    <Grid Background="#2B2B2B">
        <StackPanel VerticalAlignment="Center" Margin="30">

            <Label Content="Download video from Youtube"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>
            <Label Content="Paste link here:  "
                Foreground="DarkGray"
                FontSize="10"
                />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="urlTable"
             Grid.Column="0"
             Foreground="Gray"
             Background="#3C3F41"
             BorderBrush="#555"
             FontSize="14"
             Height="35"
             Padding="8,0"
             VerticalContentAlignment="Center"
            />

                <ComboBox x:Name="typeBox"
              Grid.Column="1"
              Width="80"
              Height="35"
              Margin="10,0,0,0"
              Background="#3C3F41"
              Foreground="#3C3F41"
              />

                <ComboBox x:Name="qualityBox"
              Grid.Column="2"
              Width="80"
              Height="35"
              Margin="10,0,0,0"
              Background="#3C3F41"
              Foreground="#3C3F41"
              />

                <Button Grid.Column="3"
            Content="Download"
            Width="100"
            Height="35"
            Margin="10,0,0,0"
            Background="#FF0000"
            Foreground="White"
            BorderThickness="0"
            Click="Button_Click"/>

                <ProgressBar x:Name="progressBar"
             Height="10"
             Margin="0,48,0,-23"
             Background="#3C3F41"
             Foreground="Green"
             Minimum="0"
             Maximum="100"
             Value="0"/>

                <Label x:Name="progressLabel"
           Foreground="White"
           FontSize="12"
           HorizontalAlignment="Left"
           Content="0%" Grid.Column="1" Margin="5,40,0,-40"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>